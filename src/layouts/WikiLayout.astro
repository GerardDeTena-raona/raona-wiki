---
import {ClientRouter} from "astro:transitions"
import WikiSidebar from "@components/WikiSidebar.astro";
import LanguageSwitcher from "@components/LanguageSwitcher.astro";
import type { BasicComponentProps } from "@config/types";
import { useTranslations } from "@i18n/ui";
import { getLocale, locales, localizedUrl, stripLocale } from "@i18n/utils";
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/global.css";
type Props = BasicComponentProps;

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const {title, description = t('site.description')} = Astro.props;

// hreflang needs absolute URLs, so it is only emitted once `site` is set in astro.config.
const rest = stripLocale(Astro.url.pathname);
const alternates = Astro.site
  ? locales.map((code) => ({ code, href: new URL(localizedUrl(code, rest), Astro.site).href }))
  : [];
---
<!DOCTYPE html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title} | {t('site.titleSuffix')}</title>
    {alternates.map(({code, href}) => <link rel="alternate" hreflang={code} href={href} />)}

    <!-- Resolve the theme before first paint to avoid a flash. -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('wiki-theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>

    <ClientRouter />
    <script>
      import "../scripts/wiki";
    </script>
  </head>
  <body
    data-copy={t('code.copy')}
    data-copied={t('code.copied')}
    data-copy-aria={t('code.copyAria')}
    data-copy-fail={t('code.copyFail')}
    data-anchor={t('doc.anchor')}
  >
    <a class="skip-link" href="#main">{t('a11y.skip')}</a>

    <header class="topbar">
      <div class="topbar-section start">
        <button
          type="button"
          class="icon-btn nav-toggle"
          data-nav-toggle
          aria-controls="site-nav"
          aria-expanded="false"
          aria-label={t('nav.toggle')}
        >
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"/></svg>
        </button>
        <slot name="topbar.start">
          <a href={localizedUrl(locale, '/')} class="logo">
            <span class="logo-mark" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m8 7-5 5 5 5M16 7l5 5-5 5"/></svg>
            </span>
            <span class="logo-text">{t('site.name')}</span>
            <span class="logo-tag">{t('site.tag')}</span>
          </a>
        </slot>
      </div>

      <div class="topbar-section center">
        <slot name="topbar.center">
        </slot>
      </div>

      <div class="topbar-section end">
        <slot name="topbar.end">
        </slot>
        <LanguageSwitcher />
        <button type="button" class="icon-btn" data-theme-toggle aria-label={t('theme.toggle')} title={t('theme.toggle')}>
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        </button>
      </div>
      <div class="progress" data-progress aria-hidden="true"></div>
    </header>

    <div class="scrim" data-nav-close aria-hidden="true"></div>
    <aside class="sidebar" id="site-nav">
      <WikiSidebar />
    </aside>

    <main class="stage" id="main">
      <div class="backdrop" aria-hidden="true"></div>
      <div class="content">
        <slot />
      </div>
    </main>
  </body>
</html>

<style>
  :root {
    --topbar-height: 3.75rem;
    --sidebar-width: 17.5rem;
  }

  body {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    grid-template-rows: var(--topbar-height) minmax(0, 1fr);
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
  }

  .skip-link {
    position: fixed;
    top: 0.5rem;
    left: 0.5rem;
    z-index: 100;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius-md);
    background: var(--color-accent);
    color: var(--color-accent-2);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .skip-link:focus {
    transform: translateY(0);
  }

  /* ---------- Topbar ---------- */

  .topbar {
    position: relative;
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0 1.25rem;
    background-color: var(--color-glass);
    backdrop-filter: saturate(160%) blur(14px);
    -webkit-backdrop-filter: saturate(160%) blur(14px);
    border-bottom: 1px solid var(--color-border);
    z-index: 30;
  }

  .topbar-section {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .topbar-section.center {
    flex: 1;
    justify-content: center;
  }

  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-text-strong);
    text-decoration: none;
    font-weight: 650;
    font-size: 1rem;
    letter-spacing: -0.015em;
  }

  .logo-mark {
    display: grid;
    place-items: center;
    width: 1.85rem;
    height: 1.85rem;
    border-radius: 0.55rem;
    color: var(--color-accent-2);
    background: linear-gradient(135deg, #ffb170, var(--color-accent) 55%, #e8711a);
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.18) inset, 0 4px 14px -4px var(--color-accent-ring);
    transition: transform var(--dur) var(--ease-out);
  }

  .logo:hover .logo-mark {
    transform: rotate(-6deg) scale(1.06);
  }

  .logo-tag {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-muted);
    font: 500 0.6875rem/1.5 var(--font-mono);
    letter-spacing: 0.02em;
  }

  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease;
  }

  .icon-btn:hover {
    color: var(--color-text-strong);
    background-color: var(--color-surface-hover);
    border-color: var(--color-border-strong);
  }

  /* Icon shows the theme you would switch to */
  :global(:root[data-theme='dark']) .icon-moon,
  :global(:root[data-theme='light']) .icon-sun {
    display: none;
  }

  .nav-toggle {
    display: none;
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), #ffc08a);
    transform: scaleX(0);
    transform-origin: left;
    pointer-events: none;
  }

  /* ---------- Sidebar ---------- */

  .sidebar {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem 0.875rem 2rem;
    background-color: var(--color-bg-raised);
    border-right: 1px solid var(--color-border);
  }

  .scrim {
    display: none;
  }

  /* ---------- Stage / content ---------- */

  .stage {
    position: relative;
    min-height: 0;
    min-width: 0;
  }

  .backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(60rem 28rem at 15% -8%, var(--color-accent-soft), transparent 70%),
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 2.5rem 2.5rem;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, transparent 70%);
    mask-image: linear-gradient(to bottom, #000 0%, transparent 70%);
  }

  .content {
    position: relative;
    height: 100%;
    overflow-y: auto;
    scroll-behavior: smooth;
    scroll-padding-top: 1.5rem;
    padding: 2.5rem clamp(1.25rem, 4vw, 3.5rem) 5rem;
  }

  /* ---------- Responsive ---------- */

  @media (max-width: 900px) {
    body {
      grid-template-columns: minmax(0, 1fr);
    }

    .nav-toggle {
      display: inline-grid;
    }

    .logo-tag {
      display: none;
    }

    .sidebar {
      position: fixed;
      top: var(--topbar-height);
      bottom: 0;
      left: 0;
      z-index: 25;
      width: min(20rem, 86vw);
      transform: translateX(-100%);
      transition: transform var(--dur) var(--ease-out);
      box-shadow: 0 0 60px rgb(0 0 0 / 0.5);
    }

    :global(body[data-nav-open]) .sidebar {
      transform: translateX(0);
    }

    .scrim {
      position: fixed;
      inset: var(--topbar-height) 0 0 0;
      z-index: 20;
      display: block;
      background: rgb(0 0 0 / 0.5);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--dur) ease;
    }

    :global(body[data-nav-open]) .scrim {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
