---
import { getCollection } from 'astro:content';
import type { DocEntry, GroupedDocsAcc } from '@config/types';

const allDocs: DocEntry[] = await getCollection('docs');

const groupedDocs = allDocs.reduce<GroupedDocsAcc>((acc, doc) => {
  const group = doc.data.navGroup?.trim() || 'General';

  (acc[group] ??= []).push(doc);
  return acc;
}, {});

Object.values(groupedDocs).forEach(docs => {
  docs.sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
});

const navGroups = Object.entries(groupedDocs);

const currentPath = Astro.url.pathname;
---

<nav class="sidebar-nav">
  {navGroups.map(([groupName, docs]) => (
    <div class="nav-group">
      <h3 class="nav-group-title">{groupName}</h3>
      <ul class="nav-list">
        {docs.map(doc => {
          const docPath = `/docs/${doc.id}`;
          const isActive = currentPath === docPath || currentPath === `${docPath}/`;

          return (
            <li class="nav-item">
              <a 
                href={docPath} 
                class={`nav-link ${isActive ? 'active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {doc.data.title}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</nav>

<style>
  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 2rem; 
  }

  .nav-group-title {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-title-text);
    margin-bottom: 0.75rem;
    margin-top: 0;
    padding-left: 0.75rem;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .nav-link {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    padding: 0.4rem 0.75rem;
    color: var(--color-on-dark-muted);
    text-decoration: none;
    border-radius: 0.375rem;
    font-size: 0.95rem;
    transition: color 0.2s ease-in-out;
  }

  /* Accent layer that slides in from the left (keyframes in global.css) */
  .nav-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-accent);
    transform: translateX(-100%);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--color-accent-2);
  }

  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    animation: slide-right 0.3s ease-out forwards;
  }

  /* Selected: accent outline over a dark accent tint, no slide layer */
  .nav-link.active,
  .nav-link.active:hover,
  .nav-link.active:focus-visible {
    color: var(--color-title-text);
    font-weight: 600;
    background-color: color-mix(in srgb, var(--color-accent) 25%, var(--color-accent-2));
    outline: 1px solid var(--color-accent);
    outline-offset: -1px;
  }

  .nav-link.active::after {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-link:hover::after,
    .nav-link:focus-visible::after {
      animation-duration: 0.01ms;
    }
  }
</style>