---
import { getNavGroups } from '@config/nav';
import { useTranslations } from '@i18n/ui';
import { getLocale, localizedUrl, samePath } from '@i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const navGroups = await getNavGroups(locale);

const currentPath = Astro.url.pathname;
---

<div class="sidebar-search">
  <svg class="search-icon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  <input
    type="search"
    class="search-input"
    data-nav-filter
    placeholder={t('nav.filter')}
    aria-label={t('nav.filterLabel')}
    autocomplete="off"
    spellcheck="false"
  />
  <kbd class="search-kbd" aria-hidden="true">/</kbd>
</div>

<nav class="sidebar-nav" aria-label={t('nav.label')}>
  {navGroups.map(({ label, docs }) => (
    <details class="nav-group" open>
      <summary class="nav-group-title">
        <svg class="chevron" viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
        <span class="group-name">{label}</span>
        <span class="group-count">{docs.length}</span>
      </summary>
      <ul class="nav-list">
        {docs.map(doc => {
          const docPath = localizedUrl(locale, `/docs/${doc.slug}`);
          const isActive = samePath(currentPath, docPath);

          return (
            <li class="nav-item">
              <a
                href={docPath}
                class={`nav-link ${isActive ? 'active' : ''}`}
                aria-current={isActive ? 'page' : undefined}
              >
                {doc.title}
              </a>
            </li>
          );
        })}
      </ul>
    </details>
  ))}
  <p class="nav-empty" data-nav-empty hidden>{t('nav.empty')}</p>
</nav>

<style>
  .sidebar-search {
    position: sticky;
    top: -1.25rem;
    z-index: 2;
    margin: -1.25rem -0.875rem 1rem;
    padding: 1.25rem 0.875rem 0.75rem;
    background: linear-gradient(var(--color-bg-raised) 75%, transparent);
  }

  .search-icon {
    position: absolute;
    left: 1.5rem;
    top: 50%;
    margin-top: 0.1rem;
    color: var(--color-text-faint);
    pointer-events: none;
    translate: 0 -50%;
  }

  .search-input {
    width: 100%;
    padding: 0.5rem 2.25rem 0.5rem 2.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-body);
    color: var(--color-text);
    font: inherit;
    font-size: 0.875rem;
    appearance: none;
    transition:
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }

  .search-input::placeholder {
    color: var(--color-text-faint);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-input:focus {
    outline: none;
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft);
  }

  .search-kbd {
    position: absolute;
    right: 1.4rem;
    top: 50%;
    margin-top: 0.1rem;
    translate: 0 -50%;
    pointer-events: none;
  }

  .search-input:focus ~ .search-kbd {
    opacity: 0;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .nav-group-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.4rem;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-faint);
    font-size: 0.6875rem;
    font-weight: 650;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color var(--dur-fast) ease;
  }

  .nav-group-title::-webkit-details-marker {
    display: none;
  }

  .nav-group-title:hover {
    color: var(--color-text-muted);
  }

  .chevron {
    flex: none;
    transition: transform var(--dur) var(--ease-out);
  }

  .nav-group[open] > .nav-group-title .chevron {
    transform: rotate(90deg);
  }

  .group-name {
    flex: 1;
  }

  .group-count {
    padding: 0 0.4rem;
    border-radius: 999px;
    background-color: var(--color-inline-code-bg);
    font: 500 0.6875rem/1.5 var(--font-mono);
    letter-spacing: 0;
  }

  .nav-list {
    list-style: none;
    margin: 0 0 0 0.9rem;
    padding: 0 0 0 0.5rem;
    border-left: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .nav-link {
    position: relative;
    display: block;
    padding: 0.38rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.4;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  .nav-link:hover {
    color: var(--color-text-strong);
    background-color: var(--color-surface-hover);
  }

  /* Active rail overlaps the group guide line */
  .nav-link.active {
    color: var(--color-accent-text);
    font-weight: 600;
    background-color: var(--color-accent-soft);
  }

  .nav-link.active::before {
    content: '';
    position: absolute;
    left: calc(-0.5rem - 1px);
    top: 0.3rem;
    bottom: 0.3rem;
    width: 2px;
    border-radius: 2px;
    background-color: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent);
  }

  .nav-empty {
    margin: 0;
    padding: 0.5rem;
    color: var(--color-text-faint);
    font-size: 0.85rem;
  }
</style>
