---
import WikiLayout from '@layouts/WikiLayout.astro';
import { getNavGroups } from '@config/nav';

const groups = await getNavGroups();
const totalDocs = groups.reduce((sum, [, docs]) => sum + docs.length, 0);
const [, firstDocs] = groups[0] ?? [];
const startHref = firstDocs?.[0] ? `/docs/${firstDocs[0].id}` : undefined;
---

<WikiLayout title="Home">
  <div class="home">
    <section class="hero">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Raona · Internal Projects</p>
      <h1>Engineering docs,<br /><span class="grad">built for builders.</span></h1>
      <p class="lede">
        Architecture, contracts, state, styling and testing conventions for the Raona internal projects,
        in one searchable place.
      </p>
      <div class="hero-actions">
        {startHref && <a class="btn" href={startHref}>Start reading <span aria-hidden="true">→</span></a>}
        <span class="meta"><kbd>/</kbd> to filter · {totalDocs} docs · {groups.length} sections</span>
      </div>
    </section>

    <section class="grid" aria-label="Sections">
      {groups.map(([name, docs], i) => (
        <article class="card" style={`--i:${i}`}>
          <header class="card-head">
            <h2>{name}</h2>
            <span class="count">{docs.length}</span>
          </header>
          <ul>
            {docs.map((doc) => (
              <li><a href={`/docs/${doc.id}`}>{doc.data.title}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </section>
  </div>
</WikiLayout>

<style>
  .home {
    max-width: 66rem;
    margin: 0 auto;
  }

  .hero {
    padding: clamp(1.5rem, 6vw, 4rem) 0 clamp(2rem, 5vw, 3.5rem);
    animation: rise 0.6s var(--ease-out) both;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 1.25rem;
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background-color: var(--color-glass);
    color: var(--color-text-muted);
    font: 500 0.75rem/1.4 var(--font-mono);
  }

  .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-soft), 0 0 12px var(--color-accent);
  }

  h1 {
    margin: 0 0 1.25rem;
    color: var(--color-text-strong);
    font-size: clamp(2.4rem, 6vw, 4.25rem);
    font-weight: 750;
    line-height: 1.04;
    letter-spacing: -0.045em;
  }

  .grad {
    background: linear-gradient(100deg, #ffc08a, var(--color-accent) 50%, #e8711a);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .lede {
    max-width: 38rem;
    margin: 0 0 2rem;
    color: var(--color-text-muted);
    font-size: clamp(1.02rem, 1.6vw, 1.2rem);
    line-height: 1.6;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
  }

  .meta {
    color: var(--color-text-faint);
    font: 500 0.78rem/1.4 var(--font-mono);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
    gap: 1rem;
  }

  .card {
    position: relative;
    padding: 1.15rem 1.2rem 1rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    box-shadow: var(--shadow-card);
    animation: rise 0.55s var(--ease-out) both;
    animation-delay: calc(var(--i) * 45ms + 120ms);
    transition:
      border-color var(--dur) ease,
      transform var(--dur) var(--ease-out);
  }

  /* Cursor-agnostic top glow that lights up on hover */
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-accent), transparent);
    opacity: 0;
    transition: opacity var(--dur) ease;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--color-border-strong);
    transform: translateY(-3px);
  }

  .card:hover::before,
  .card:focus-within::before {
    opacity: 1;
  }

  .card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .card h2 {
    margin: 0;
    color: var(--color-text-strong);
    font-size: 0.8125rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .count {
    padding: 0 0.5rem;
    border-radius: 999px;
    background-color: var(--color-accent-soft);
    color: var(--color-accent-text);
    font: 600 0.72rem/1.7 var(--font-mono);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.4rem 0.5rem;
    margin: 0 -0.5rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition:
      color var(--dur-fast) ease,
      background-color var(--dur-fast) ease;
  }

  li a::after {
    content: '→';
    color: var(--color-accent);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity var(--dur-fast) ease,
      transform var(--dur) var(--ease-out);
  }

  li a:hover {
    color: var(--color-text-strong);
    background-color: var(--color-surface-hover);
  }

  li a:hover::after {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
  }
</style>
